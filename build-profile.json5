{
  "app": {
    // 产品配置
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.5(17)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "externalNativeOptions": {
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      },
      {
        "name": "release",
        "compatibleSdkVersion": "5.0.5(17)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "externalNativeOptions": {
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          // 入口模块的产品信息配置
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    },
    {
      "name": "proxy_core",
      "srcPath": "./proxy_core"
    },
    {
      "name": "xb_components",
      "srcPath": "./xb_components"
    }
  ]
}
